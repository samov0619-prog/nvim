;; extends
; ~/.config/nvim/after/queries/css/textobjects.scm
;
; Обслуживает css И scss: стоковый queries/scss/textobjects.scm — это ровно
; одна строка `; inherits: css`, своего у него нет ничего.
;
; `;; extends` обязателен: стоковый queries/css/textobjects.scm существует
; (там @assignment.*, @number.inner, @comment.outer) и без модлайна заберёт
; роль базы, а этот файл молча выбросится.
;
; Новых клавиш не нужно — всё ложится на уже настроенные маппинги.

; ============================================================================
; Правило целиком: селекторы + { }        -> ac / ic, ]] / [[
; Именно это даёт "прыжки по классам/айдишникам/тегам".
; ============================================================================
(rule_set) @class.outer

(rule_set
  (block
    .
    "{"
    _+ @class.inner
    "}"
    .))

; ============================================================================
; Блок { }                                 -> ao / io
; ============================================================================
(block) @block.outer

(block
  .
  "{"
  _+ @block.inner
  "}"
  .)

; ============================================================================
; Отдельный селектор внутри списка `.a, #b, div`   -> aa / ia, ]a / [a
; В css-грамматике полей (fields) нет вообще, поэтому только по детям.
; outer == inner: вокруг селектора нет обёртки, кроме запятой.
; ============================================================================
(selectors
  (_) @parameter.inner @parameter.outer)

; ============================================================================
; var() / rgb() / clamp() / calc()         -> am / im
; ============================================================================
(call_expression) @call.outer

(call_expression
  (arguments
    .
    "("
    _+ @call.inner
    ")"
    .))

; ============================================================================
; @media / @supports                       -> ai / ii, ]i / [i
; ============================================================================
[
  (media_statement)
  (supports_statement)
] @conditional.outer

(media_statement
  (block
    .
    "{"
    _+ @conditional.inner
    "}"
    .))

; ============================================================================
; @swappable.outer                         -> <leader>a / <leader>A
; ============================================================================

; порядок свойств внутри блока
(block
  (declaration) @swappable.outer)

; вложенные правила (актуально для scss)
(block
  (rule_set) @swappable.outer)

; селекторы в списке: .a, #b, div
(selectors
  (_) @swappable.outer)
